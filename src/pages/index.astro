---
import MovieCard from '../components/MovieCard.astro';
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar'
import RandomMovie from '../components/RandomMovie.astro';

const res = await fetch("https://ghibliapi.vercel.app/films")

const films: any[] = await res.json()
---

<Layout title="Studio Ghibli Movies" >
	<h1 class="mb-6 text-3xl font-bold">Movies</h1>

	<h2 class="mb-6 text-2xl">Your movie for today!</h2>

	<RandomMovie server:defer>
		<div slot="fallback" class="mb-8 h-48 bg-zinc-800 animate-pulse rounded-2xl"></div>
	</RandomMovie>
	
	<SearchBar films={films} client:load>

	</SearchBar>

</Layout>
